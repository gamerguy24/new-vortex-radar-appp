PORT=4000

# Leave unset to have a strong secret generated and stored in backend/data/.jwt-secret.
# Set explicitly in production. Changing it signs everyone out.
JWT_SECRET=
TOKEN_TTL=8h

# Postgres. If unreachable the server falls back to a JSON file in backend/data/
# unless DB_REQUIRED=true, which makes a missing database a startup failure.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cad_dispatch
DB_REQUIRED=false

# Comma-separated list, or * to allow any origin.
CORS_ORIGIN=http://localhost:3000

# Where the file-backed user store and generated secret live.
DATA_DIR=./data

# Set to false to close public sign-ups; admins can still create accounts.
ALLOW_SELF_REGISTRATION=true
BOOTSTRAP_ADMIN_USERNAME=admin

APP_NAME=CAD Dispatch

# Self-service password reset. Users request a temporary password from the
# sign-in page and it is emailed to the address on their account.
# How long an emailed temporary password stays valid, in minutes.
TEMP_PASSWORD_TTL_MINUTES=60

# Leave SMTP_HOST blank to write reset emails to backend/data/outbox/ instead of
# sending them — useful for local testing, but nothing reaches real users.
#
# Zoho Mail. Pick the host for the region your Zoho account was created in:
#   smtp.zoho.com     US / global      smtp.zoho.eu       Europe
#   smtp.zoho.in      India            smtp.zoho.com.au   Australia
# A region mismatch shows up as an authentication failure, not a connection error.
#
# SMTP_USER is the full email address. SMTP_PASSWORD must be an application-specific
# password if two-factor auth is enabled on the account.
#
# MAIL_FROM must match SMTP_USER (or a verified alias on it) — Zoho rejects any
# other From address with a relaying/spoofing error.
#
# Verify with:  npm run mail:test -- you@yourdomain.com
#
# Left blank on purpose: with no SMTP_HOST the app writes to the outbox instead of
# half-sending. Fill all four lines together when you are ready to go live.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Leave blank to infer from the port (465 = implicit TLS, otherwise STARTTLS).
SMTP_SECURE=
MAIL_FROM=

# Zoho, filled in:
#   SMTP_HOST=smtp.zoho.com
#   SMTP_PORT=465
#   SMTP_USER=no-reply@yourdomain.com
#   SMTP_PASSWORD=<application-specific password>
#   MAIL_FROM=CAD Dispatch <no-reply@yourdomain.com>
