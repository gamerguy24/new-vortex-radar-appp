# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded automatically by server.js (via dotenv). Never commit real secrets.

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# The SECRET key (starts with sk_live_ or sk_test_), NOT the publishable pk_ key.
# If a secret key was ever pasted/leaked, ROLL IT FIRST at
# https://dashboard.stripe.com/apikeys and paste the NEW one here.
STRIPE_SECRET_KEY=

# Price ID for the Pro subscription (price IDs are not secret).
STRIPE_PRICE_ID=

# Webhook signing secret (whsec_…). For local testing:
#   stripe listen --forward-to localhost:3333/api/billing/webhook
# and paste the whsec_… it prints. Without this, webhooks fail signature
# verification and paid users won't be upgraded to Pro.
STRIPE_WEBHOOK_SECRET=

# Optional redirect overrides (sensible defaults are used if unset).
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# STRIPE_PORTAL_RETURN_URL=

# ── YouTube Live (Chase Stream Hub auto-broadcast) ───────────────────────────
# OAuth client from Google Cloud Console (APIs & Services ▸ Credentials ▸
# "OAuth client ID" of type "Web application"). Full walkthrough:
#   docs/youtube_live_setup.md
# Without these, the Hub's YouTube "Connect" button returns 503 and YouTube
# auto-post stays disabled; the rest of the Hub works normally.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: force the OAuth redirect URI. If unset it's derived per-request as
#   {proto}://{host}/api/stream/connect/youtube/callback
# Whatever value is used MUST be listed as an Authorized redirect URI in the
# Google Cloud OAuth client. Set this in production to avoid proxy host guesses.
# YOUTUBE_REDIRECT_URI=https://vortex-dome22.onrender.com/api/stream/connect/youtube/callback
