# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Loaded automatically by server.js (via dotenv). Never commit real secrets.

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# The SECRET key (starts with sk_live_ or sk_test_), NOT the publishable pk_ key.
# If a secret key was ever pasted/leaked, ROLL IT FIRST at
# https://dashboard.stripe.com/apikeys and paste the NEW one here.
STRIPE_SECRET_KEY=

# Price ID for the Pro subscription (price IDs are not secret).
STRIPE_PRICE_ID=

# Webhook signing secret (whsec_…). For local testing:
#   stripe listen --forward-to localhost:3333/api/billing/webhook
# and paste the whsec_… it prints. Without this, webhooks fail signature
# verification and paid users won't be upgraded to Pro.
STRIPE_WEBHOOK_SECRET=

# Optional redirect overrides (sensible defaults are used if unset).
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
# STRIPE_PORTAL_RETURN_URL=

# ── Automatic NWS warning → Bluesky posting ──────────────────────────────────
# The server polls NWS for new warnings, renders a broadcast graphic, and posts
# it to Bluesky. Detection + graphics work WITHOUT these vars (posting is simply
# skipped and shown in the admin log); set them to enable posting.
#
# Your Bluesky handle, e.g. vortexradar.bsky.social (no leading @).
BLUESKY_HANDLE=
# An APP PASSWORD (Bluesky Settings → App Passwords) — NOT your login password.
# Format looks like xxxx-xxxx-xxxx-xxxx. Never commit the real value.
BLUESKY_APP_PASSWORD=
# Optional: PDS service URL (defaults to https://bsky.social).
# BLUESKY_SERVICE=

# Optional: Mapbox token for the graphic basemap. Defaults to the app's existing
# public map token; override only to use a separate token/quota.
# MAPBOX_STATIC_TOKEN=
# MAPBOX_STATIC_STYLE=dark-v11

# Optional tuning (sensible defaults if unset):
# NWS_POLL_SECONDS=60            # how often to poll NWS (min 30)
# NWS_MAX_POSTS_PER_CYCLE=8      # cap posts per poll cycle (rate-limit safety)
# NWS_USER_AGENT=VortexRadar (your-domain.com, you@example.com)  # required by NWS API etiquette

# ── Critical Weather Alerts (free-first, self-hosted notifications) ───────────
# Saved locations + NWS warning matching. NONE of these are required for the core
# feature (saved locations, matching, in-app + browser push) to work — each just
# enables an extra delivery channel. No paid SMS provider is ever required.
#
# NWS API etiquette (a descriptive UA is required by api.weather.gov):
# NWS_USER_AGENT=VortexRadar (your-domain.com, you@example.com)
#
# Email + email-to-SMS (SMTP). Also used to reach carrier email-to-SMS gateways.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@your-domain.com
#
# Browser push (Web Push / VAPID). Generate a keypair once (npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com
#
# Optional per-deployment default channels (users can set their own too):
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=
#
# Optional future paid SMS provider (NOT required — Text Gateway abstracts it):
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_API_SECRET=
#
# APP_URL is used to build the radar deep-link in notifications (falls back to the
# request host). e.g. https://radar.twistcasterlivemedia.com
# APP_URL=

# ── Global PTT live audio (scanner) ──────────────────────────────────────────
# Shared secret the Windows radio gateway uses to push audio to this server
# (POST /scanner/ingest). Listeners never need it. If unset, ingest is DISABLED
# (no one can push a feed) — set a long random value and use the SAME value in
# tools/ptt_source.js / your FFmpeg command. See tools/GLOBAL_PTT_SETUP.md.
SCANNER_INGEST_KEY=
