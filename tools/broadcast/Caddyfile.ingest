# echo-radar-ingest — local router in front of MediaMTX on the broadcast box.
# Installed by tools/broadcast/install_ingest.sh as /etc/caddy/Caddyfile.
#
# Plain HTTP on 127.0.0.1:8099 only: nothing here faces the internet. The
# Cloudflare Tunnel on this box publishes it (e.g. https://stream.echoradarwx.com
# -> http://localhost:8099), so there is no certificate, no port 80/443 and no
# DNS record to manage. Any Host is accepted, since the tunnel passes the public one.

http://:8099 {
	bind 127.0.0.1

	# MediaMTX's status API, polled by the main Echo Radar app. MediaMTX asks
	# Echo Radar to check every call, so only the app (holding the secret) gets in.
	handle /v3/* {
		reverse_proxy 127.0.0.1:9997
	}
	# HLS for viewers. Each needs a watch token signed by Echo Radar.
	handle {
		reverse_proxy 127.0.0.1:8888
	}
}
