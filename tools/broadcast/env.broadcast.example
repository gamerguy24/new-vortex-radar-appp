# tools/broadcast/env.broadcast.example
#
# The ONLY settings a broadcast node needs. Copy this to .env on that box and
# fill in the two keys — do not copy the .env from your main server.
#
#   cp tools/broadcast/env.broadcast.example .env
#   nano .env
#
# WHY NOT JUST COPY THE REAL ONE
# Your main .env holds payment keys, mail credentials, session secrets and the
# admin account. A broadcast node needs none of it: it renders a public page and
# pushes video out. Copying the lot would put every secret you have on a machine
# whose whole job is to talk to the open internet, for no benefit. Verified by
# booting the app with exactly these lines — it serves /broadcast and the radar
# relay and nothing complains.

# ── where the app listens ───────────────────────────────────────────────────
# 127.0.0.1 on purpose. This is a second copy of the whole application, admin
# pages included, and nothing outside this box has any business reaching it.
# The default is 0.0.0.0, which on a machine with a public IP would publish it.
HOST=127.0.0.1
PORT=3333

APP_NAME=Echo Radar
DATA_DIR=./server_data

# ── where the stream goes ───────────────────────────────────────────────────
# At least one. Both, and it goes to both from a single encode.
YT_STREAM_KEY=
TWITCH_STREAM_KEY=

# Optional extra ingests:
# CF_STREAM_KEY=
# EXTRA_RTMP_URLS=rtmp://host/app/key rtmp://other/app/key

# ── the page the encoder points at ──────────────────────────────────────────
# ?loop=N sets how many scans the radar loop plays. Each frame is a volume
# decoded in the browser, so it is the biggest thing this costs in memory:
# 5 is the default, 2 suits a small box, 1 turns looping off.
BROADCAST_URL=http://127.0.0.1:3333/broadcast

# ── optional: picture size ──────────────────────────────────────────────────
# Lower both together if the box cannot keep up, or to halve the upload. A
# radar map reads perfectly well at 720p.
# STREAM_WIDTH=1280
# STREAM_HEIGHT=720
# STREAM_BITRATE=2500k
